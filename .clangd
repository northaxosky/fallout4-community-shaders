# Generate the compile database first (from a plain shell):
#   pwsh scripts/gen-compile-commands.ps1     (or: cmake --preset=clangd from a VS dev prompt)
# That writes build/clangd/compile_commands.json (gitignored); clangd reads it via the pointer below.
CompileFlags:
  CompilationDatabase: build/clangd
  # Drop MSVC precompiled-header flags: clangd cannot load a cl.exe-produced .pch and builds its
  # own preamble. The /FI force-include of the pch wrapper header is kept (clangd parses it fine).
  Remove:
    - /Yu*
    - /Fp*
