{
  "name": "fo4-community-shaders",
  "version-string": "0.2.0",
  "description": "Community Shaders port for Fallout 4",
  "supports": "windows & x64",
  "dependencies": [
    "directx-headers",
    "directxtex",
    "directxtk",
    {
      "name": "imgui",
      "features": [ "dx11-binding", "win32-binding", "docking-experimental" ]
    },
    "magic-enum",
    {
      "name": "spdlog",
      "features": [ "wchar" ]
    },
    "sqlite3",
    "tomlplusplus",
    {
      "name": "tracy",
      "features": [ "on-demand" ]
    },
    "xbyak"
  ]
}
