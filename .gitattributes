*.sh text eol=lf
*.py text eol=lf
# Producer-published artifacts must stay byte-identical to the producer artifact.
scripts/shaders/shader-fidelity-conformance.json -text
package/Textures/**/*.dds filter=lfs diff=lfs merge=lfs -text
# Shader cache keys hash source bytes; pin endings so checkouts agree.
*.hlsl text eol=crlf
*.hlsli text eol=crlf
package/Shaders/**/*.h text eol=crlf
