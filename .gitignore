# Build output
build/
build-*/
out/
bin/
*.exp
*.lib
*.obj
*.pdb
*.ilk
*.idb

# Logs
*.log

# Generated tool output, do not commit
docs/shader-buffers.md
.tmp-roundtrip/
__pycache__/

# Vendored Detours static libs are NOT build output, track them.
!include/detours/**/*.lib
!include/detours/**/*.pdb

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
Makefile
*.cmake.in
compile_commands.json

# Visual Studio
.vs/
*.vcxproj.user
*.suo

# IDE
.idea/
.vscode/
.cache/

# Local config / secrets
scripts/.env

# SDK runtime DLL cache (per FO4Upscaling pattern)
.sdk-cache/
package/F4SE/Plugins/Streamline/
package/F4SE/Plugins/FrameGeneration/FidelityFX/
package/F4SE/Plugins/FrameGeneration/XeSS/

# Test output
test-results/

# Local agent / instruction files (private per global CLAUDE.md policy)
CLAUDE.md
AGENTS.md
GEMINI.md
.github/copilot-instructions.md

# Local-only project notes (also caught by user-global gitignore but explicit here)
.local/
.agents/

# OS
.DS_Store
Thumbs.db
