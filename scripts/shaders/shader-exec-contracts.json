          "replacements": [
            {
              "old": "    float wetFilmRoughness = max(saturate(1.0 - wetness), 0.05);\n    float wetFilmStrength = saturate(1.0 - wetFilmRoughness);\n    float3 wetFilmNormal = isMaterial1 ? matSample.xyz : normalView;\n    wetFilmNormal *=\n        rsqrt(max(dot(wetFilmNormal, wetFilmNormal), 1.0e-8));\n    float3 wetFilmHalf = viewDirNeg + SunDirection_and_padding.xyz;\n    wetFilmHalf *= rsqrt(max(dot(wetFilmHalf, wetFilmHalf), 1.0e-8));",
              "new": "    float wetGloss = max(matSample.x, wetness * 0.7);\n    float wetSpecMag = max(matSample.y, wetness * 0.25);"
            },
            {
              "old": "        float specExpBase = exp2(matSample.x * 10.0 + 1.0);",
              "new": "        float specExpBase = exp2(wetGloss * 10.0 + 1.0);"
