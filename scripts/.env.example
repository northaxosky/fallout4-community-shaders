# Copy this file to scripts/.env and customize paths for your setup.
# All paths use forward slashes (Git Bash style).

# vcpkg installation
VCPKG_ROOT="C:/Utilities/PackageManagers/vcpkg"

# MO2 mod folder where DLL is deployed
MOD_DIR="C:/Games/Modding/The Midnight Ride/mods/FO4 Community Shaders"

# F4SE log directory (for monitoring runtime logs)
F4SE_LOG_DIR="C:/Users/$USER/Documents/My Games/Fallout4/F4SE"

# Required for ./scripts/test.sh - MO2 launcher + profile
MO2_EXE="C:/Games/Modding/The Midnight Ride/MidnightRide.exe"
MO2_PROFILE="Test"
MO2_EXECUTABLE="F4SE"
